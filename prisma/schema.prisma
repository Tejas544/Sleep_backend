generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Practitioner {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  hospitalName   String?
  planType       PlanType       @default(FREE)
  patients       Patient[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Patient {
  id             String         @id @default(uuid())
  practitionerId String
  practitioner   Practitioner   @relation(fields: [practitionerId], references: [id])
  firstName      String
  lastName       String
  age            Int
  reports        Report[]
  createdAt      DateTime       @default(now())
}

model Report {
  id             String         @id @default(uuid())
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  clinicalScore  Float
  totalSleepMin  Int
  deepSleepMin   Int
  remSleepMin    Int
  status         ReportStatus   @default(ANALYZED)
  createdAt      DateTime       @default(now())
}

model Payment {
  id             String         @id @default(uuid())
  practitionerId String
  practitioner   Practitioner   @relation(fields: [practitionerId], references: [id])
  rzpOrderId     String         @unique
  rzpPaymentId   String?        @unique
  amount         Int            // In paise
  planName       String
  status         PaymentStatus  @default(PENDING)
  createdAt      DateTime       @default(now())
}

enum PlanType {
  FREE
  INTERMEDIATE
  ADVANCE
}

enum ReportStatus {
  PROCESSING
  ANALYZED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}